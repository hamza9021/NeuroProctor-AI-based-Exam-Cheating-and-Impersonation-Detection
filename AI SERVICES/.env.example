# =============================================================================
# NeuroProctor AI Services — Environment Variables
# =============================================================================
# Copy this file to .env and update the values as needed.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/neuroproctor
MONGO_DB_NAME=neuroproctor

# ── JWT ───────────────────────────────────────────────────────────────────
# ACCESS_TOKEN_SECRET MUST be identical to the Express backend secret
ACCESS_TOKEN_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256

# ── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_STUDENT_FOLDER=neuroproctor/students

# ── InsightFace / ONNX ────────────────────────────────────────────────────
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_CTX_ID=0
INSIGHTFACE_DET_SIZE=640

# ── Image Validation ──────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
EMBEDDING_DIMENSION=512

# ── AI Processing Directories ───────────────────────────────────────────────
OUTPUT_DIR=outputs
LOGS_DIR=logs
TEMP_DIR=temp
ANNOTATED_VIDEOS_DIR=annotated_videos
REPORTS_DIR=reports
EVIDENCE_DIR=evidence
